# Copy to .env and adjust. .env is never committed.
APP_ENV=dev
APP_NAME=AI ERP

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# JWT (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Scan intake: uploaded files are kept here (outside the web root, never served directly)
INBOX_DIR=var/inbox
INBOX_MAX_MB=20

# AI butler: any OpenAI-compatible chat endpoint with tool calling. Empty = off.
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-flash (or deepseek-v4-pro)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_CALLS=10

# Document recognition: any OpenAI-compatible endpoint with a vision model
# (model gateway, Qwen-VL, Ollama http://127.0.0.1:11434/v1 ...). Empty = manual entry only.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=120

# LHDN MyInvois e-invoice (register this system in the MyInvois portal to get these)
MYINVOIS_ENV=sandbox
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=
MYINVOIS_ONBEHALFOF=
